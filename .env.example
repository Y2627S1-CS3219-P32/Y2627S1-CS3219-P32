# AI Assistance Disclosure: ChatGPT (GPT-6), 2026-09-30.
# Codex (GPT-6.1), 2026-11-10: preserve mail/ranking and agent variables during rebase. Author review: Pending.
# Scope: Example root Compose environment configuration, including Mailjet welcome-email settings.
# Author review: Pending.
# ChatGPT (GPT-6), 2026-11-04: Mailjet settings are consumed by mail-service. Author review: Pending.
# Required by docker compose.
# Replace with a long, randomly generated secret before running the services.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: leave empty to disable bootstrap-secret functionality.
BOOTSTRAP_SECRET=

# Optional: defaults to 900 seconds when omitted.
JWT_ACCESS_TOKEN_TTL=900

# Optional: configure Mailjet SMTP credentials for the event-driven mail-service.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM=

# Claude Code (Opus 5.5), 2026-10-31. Author review: Pending.
# Optional: OpenAI key for order-ranking-service embeddings. Without it, the service uses a
# keyless word-overlap embedder, which works but only matches shared words.
OPENAI_API_KEY=

# Orchestrator model adapter (server-side only)
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
SOCLAAS_MODEL=default
