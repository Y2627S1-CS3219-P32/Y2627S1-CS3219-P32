# ---- Supplier database --------------------------------------
# For host-side commands, set this in supplier-service/.env to a reachable DB.
# Local Compose credentials; containers use supplier-db:5432 instead.
DATABASE_URL=postgres://supplier:supplier@127.0.0.1:5433/suppliers

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ... Add more variables as needed
