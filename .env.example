# Scope: Example root Compose environment configuration. Author review: Pending.
# Required by docker compose.
# Replace with a long, randomly generated secret before running the services.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: leave empty to disable bootstrap-secret functionality.
BOOTSTRAP_SECRET=

# Optional: defaults to 900 seconds when omitted.
JWT_ACCESS_TOKEN_TTL=900
