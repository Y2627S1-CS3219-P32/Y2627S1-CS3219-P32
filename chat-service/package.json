{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "Order chat service",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "license": "ISC",
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
