{
  "name": "credit-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --import ./dist/shared/telemetry.mjs dist/index.js",
    "command:publish": "node dist/scripts/send-command.js",
    "publisher": "node --import ./dist/shared/telemetry.mjs dist/outbox-publisher/publisher.js",
    "db:migrate": "node dist/db/migrate.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "pubsub:provision": "node dist/scripts/provision-pubsub.js",
    "test:pubsub": "npm run build && node test/pubsub.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "import-in-the-middle": "^3.5.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
