          "name": "Internal (Pub/Sub push, scheduler)",
          "description": "Local only: authenticated with the shared secret (orderInternalSecret). In Cloud these need a Google OIDC token.",
          "item": [
            {
              "name": "Push supplier.created",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-internal-secret",
                    "value": "{{orderInternalSecret}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{orderBaseUrl}}/internal/pubsub/supplier-events",
                  "host": [
                    "{{orderBaseUrl}}"
                  ],
                  "path": [
