              "path": [
                "register"
              ]
            },
            "description": "Creates a student account (university email; password needs upper, lower and a digit). Saves requesterToken and requesterId.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"displayName\": \"John-Doe\",\n  \"email\": \"{{requesterEmail}}\",\n  \"confirmEmail\": \"{{requesterEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"signed in\", () => pm.expect(body.token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"requesterToken\", body.token);",
                  "pm.collectionVariables.set(\"requesterId\", body.user.id);"
                ]
              }
            }
